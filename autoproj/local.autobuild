cmake_package "farbot"

# rtt_geometry contains independent Eigen and KDL packages. Import the source
# repository once and configure only its eigen_typekit subdirectory.
cmake_package "eigen_typekit" do |pkg|
  pkg.importdir = File.dirname(pkg.srcdir)
  pkg.use_package_xml = false
  pkg.depends_on "rtt"
  pkg.depends_on "eigen3"
  pkg.define "CMAKE_CXX_STANDARD", "20"
  pkg.define "CMAKE_CXX_STANDARD_REQUIRED", "ON"
  pkg.define "CMAKE_CXX_EXTENSIONS", "OFF"
end

move_package "eigen_typekit", "rtt_geometry"

cmake_package "rtlog-cpp" do |pkg|
  pkg.depends_on "farbot"
end

cmake_package "open62541" do |pkg|
  pkg.define "BUILD_SHARED_LIBS", "ON"
  pkg.define "UA_NAMESPACE_ZERO", "REDUCED"
  pkg.define "UA_ENABLE_PUBSUB", "OFF"
  pkg.define "UA_ENABLE_PUBSUB_INFORMATIONMODEL", "OFF"
  pkg.define "UA_BUILD_EXAMPLES", "OFF"
  pkg.define "UA_BUILD_UNIT_TESTS", "OFF"
end

cmake_package "open62541pp" do |pkg|
  pkg.depends_on "open62541"
  pkg.define "BUILD_SHARED_LIBS", "ON"
  pkg.define "UAPP_INTERNAL_OPEN62541", "OFF"
  pkg.define "UAPP_BUILD_TESTS", "OFF"
  pkg.define "UAPP_BUILD_EXAMPLES", "OFF"
  pkg.define "UAPP_BUILD_DOCUMENTATION", "OFF"
end

cmake_package "rtt_opcua" do |pkg|
  pkg.depends_on "rtt"
  pkg.depends_on "open62541"
  pkg.depends_on "open62541pp"
  pkg.define "RTT_OPCUA_WARNINGS_AS_ERRORS", "ON"
end

move_package "rtt_opcua", "tools"

# Header-only private dependency; rtt_http compiles its own listener with the
# required ownership, signal-policy, and raw-routing switches.
import_package "cpp-httplib"

cmake_package "rtt_http" do |pkg|
  pkg.depends_on "rtt"
  pkg.depends_on "cpp-httplib"
  pkg.depends_on "boost"
  pkg.depends_on "openssl"
  pkg.define "BUILD_TESTING", "OFF"
  pkg.define "RTT_HTTP_TLS", "ON"
  pkg.post_import do
    pkg.define "RTT_HTTP_HTTPLIB_INCLUDE_DIR", Autobuild::Package["cpp-httplib"].srcdir
  end
end

move_package "rtt_http", "tools"
