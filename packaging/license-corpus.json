  "license_refs": [
    {
      "id": "LicenseRef-MetaRuby-Bundled-jQuery-Notices",
      "description": "MetaRuby bundles four jQuery-era JavaScript files whose inline notices use mixed or underspecified MIT, BSD, and GPL declarations.",
      "evidence": [
        "sources/metaruby/lib/metaruby/gui/html/jquery.min.js",
        "sources/metaruby/lib/metaruby/gui/html/jquery.selectfilter.js",
        "sources/metaruby/lib/metaruby/gui/html/jquery.tagcloud.min.js",
        "sources/metaruby/lib/metaruby/gui/html/jquery.tinysort.min.js"
      ]
    },
    {
      "id": "LicenseRef-MetaRuby-Conflicting-BSD-LGPLv3-Declarations",
      "description": "The pinned MetaRuby gemspec declares BSD while the same source revision's Rock manifest declares LGPLv3; the corpus preserves both declarations without selecting one.",
      "evidence": [
        "sources/metaruby/metaruby.gemspec",
        "sources/metaruby/manifest.xml"
      ]
    },
    {
      "id": "LicenseRef-OCL-GPL-2.0-Linking-Exception",
      "description": "OCL's installed TableMarshaller.hpp is GPL-2.0-only with the project-specific template, macro, inline-function, compilation, and linking exception embedded in the header.",
      "evidence": [
        "sources/ocl/reporting/TableMarshaller.hpp"
      ]
    },
    {
      "id": "LicenseRef-Orocos-RTT-GPL-2.0-Linking-Exception",
      "description": "Orocos RTT is GPL-2.0 with the project-specific template, macro, inline-function, compilation, and linking exception stated in COPYING.md.",
      "evidence": [
        "sources/rtt/COPYING.md"
      ]
    },
    {
      "id": "LicenseRef-Orocos-RTT-TLSF-Linking-Exception",
      "description": "RTT's bundled TLSF allocator declares LGPL and GPL terms plus its own executable-linking exception.",
      "evidence": [
        "sources/rtt/rtt/os/tlsf/COPYING"
      ]
    },
    {
      "id": "LicenseRef-Ruby-base64-Mixed-Legal-Notices",
      "description": "The base64 gem combines its declared Ruby/BSD-2-Clause choice with public-domain, MIT, and old-style BSD portions documented by LEGAL.",
      "evidence": [
        "gems/base64-0.3.0/BSDL",
        "gems/base64-0.3.0/COPYING",
        "gems/base64-0.3.0/LEGAL"
      ]
    },
    {
      "id": "LicenseRef-Ruby-facets-Mixed-Bundled-Notices",
      "description": "The facets gem combines its BSD-2-Clause gemspec declaration with Ruby, BSD-3-Clause, MIT, unspecified, and custom bundled notices preserved in LICENSE.txt and NOTICE.rdoc.",
      "evidence": [
        "gems/facets-3.1.0/LICENSE.txt",
        "gems/facets-3.1.0/NOTICE.rdoc"
      ]
    },
    {
      "id": "LicenseRef-Windows-vcpkg-Bundled-Dependencies",
      "description": "The Windows development package bundles a dynamically resolved, source-lock-bound vcpkg dependency SDK; manifest.json enumerates every copied notice path and SHA256.",
      "evidence": [
        "vcpkg/** (exact paths and SHA256 values in manifest.json)"
      ]
    },
    {
      "id": "LicenseRef-open62541-base64-BSD",
      "description": "open62541's compiled bundled base64 implementation identifies its terms only as BSD, and the pinned dependency inventory does not specify a BSD variant.",
      "evidence": [
        "sources/open62541/deps/README.md",
        "sources/open62541/deps/base64.c"
      ]
    },
    {
      "id": "LicenseRef-rtlog-cpp-Bundled-License-Exceptions",
