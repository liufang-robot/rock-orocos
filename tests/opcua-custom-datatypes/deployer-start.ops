import("orocos_opcua_fixture")
loadComponent("sample", "orocos::opcua::fixture::FixtureComponent")
loadComponent("sample-full", "orocos::opcua::fixture::FixtureComponent")
loadComponent("unsupported", "orocos::opcua::fixture::UnsupportedComponent")

var StringArray deployer_selectors = StringArray(
    "operations/unloadComponent", "services/opcua/**")
var StringArray sample_selectors = StringArray(
    "operations/*", "properties/*", "attributes/*", "ports/*")

opcua.start()
opcua.publishComponentSelected("Deployer", deployer_selectors)
opcua.publishComponentSelected("sample", sample_selectors)
opcua.publishComponent("sample-full")

// Explicit transport sources; publication itself only observes.
opcua.enableInputWrite("sample.Float64ArrayInput")
opcua.enableInputWrite("sample.Int32ArrayInput")
opcua.enableInputWrite("sample.StringArrayInput")
opcua.enableInputWrite("sample.RtStringInput")
opcua.enableInputWrite("sample.PointInput")
opcua.enableInputWrite("sample.EnvelopeInput")
opcua.enableInputWrite("sample.PointArrayInput")
opcua.enableInputWrite("sample-full.Float64ArrayInput")
opcua.enableInputWrite("sample-full.Int32ArrayInput")
opcua.enableInputWrite("sample-full.StringArrayInput")
opcua.enableInputWrite("sample-full.RtStringInput")
opcua.enableInputWrite("sample-full.PointInput")
opcua.enableInputWrite("sample-full.EnvelopeInput")
opcua.enableInputWrite("sample-full.PointArrayInput")
